STRIPE_CANCEL_URL=https://your-app-domain.example/billing/cancel
STRIPE_PORTAL_RETURN_URL=https://your-app-domain.example/dashboard
COMPLIMENTARY_PRO_TELEGRAM_IDS=123456789
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
